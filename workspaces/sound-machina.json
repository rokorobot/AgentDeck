{
  "schemaVersion": "agentdeck.workspace.v2",
  "id": "sound-machina",
  "name": "Sound Machina",
  "rootPath": "E:\\AgentDeck",
  "previewUrl": "http://localhost:3000",
  "health": {
    "type": "http",
    "url": "http://localhost:3000"
  },
  "services": [
    {
      "id": "frontend",
      "label": "Frontend",
      "shell": "powershell.exe",
      "command": "echo 'npm run dev'"
    },
    {
      "id": "backend",
      "label": "Backend",
      "shell": "powershell.exe",
      "command": "echo 'python sound_engine.py'"
    }
  ],
  "quickActions": [
    {
      "id": "generate-track",
      "label": "Generate Track",
      "type": "command",
      "command": "echo 'Generating music track...' && timeout 3"
    },
    {
      "id": "start-backend",
      "label": "Start Backend",
      "type": "startService",
      "serviceId": "backend"
    },
    {
      "id": "open-prompt-engine",
      "label": "Open Prompt Engine",
      "type": "previewUrl",
      "url": "http://localhost:3000/prompt-engine"
    },
    {
      "id": "open-folder",
      "label": "Open Folder",
      "type": "openFolder"
    }
  ],
  "terminals": [
    {
      "name": "PowerShell",
      "shell": "powershell.exe",
      "cwd": "E:\\AgentDeck"
    },
    {
      "name": "WSL Ubuntu",
      "shell": "wsl.exe",
      "cwd": "~"
    }
  ]
}

{
  "schemaVersion": "agentdeck.workspace.v2",
  "id": "tm4",
  "name": "TM4 Studio",
  "rootPath": "E:\\AgentDeck",
  "previewUrl": "http://localhost:8000",
  "health": {
    "type": "http",
    "url": "http://localhost:8000"
  },
  "services": [
    {
      "id": "api",
      "label": "API Backend",
      "shell": "powershell.exe",
      "command": "echo 'uvicorn main:app --reload'"
    },
    {
      "id": "worker",
      "label": "Worker",
      "shell": "powershell.exe",
      "command": "echo 'python worker.py'"
    }
  ],
  "quickActions": [
    {
      "id": "start-api",
      "label": "Start API",
      "type": "startService",
      "serviceId": "api"
    },
    {
      "id": "start-worker",
      "label": "Start Worker",
      "type": "startService",
      "serviceId": "worker"
    },
    {
      "id": "open-dashboard",
      "label": "Open Dashboard",
      "type": "previewUrl",
      "url": "http://localhost:8000/dashboard"
    },
    {
      "id": "open-folder",
      "label": "Open Folder",
      "type": "openFolder"
    }
  ],
  "terminals": [
    {
      "name": "PowerShell",
      "shell": "powershell.exe",
      "cwd": "E:\\AgentDeck"
    },
    {
      "name": "WSL Ubuntu",
      "shell": "wsl.exe",
      "cwd": "~"
    },
    {
      "name": "Ollama Monitor",
      "shell": "powershell.exe",
      "command": "ollama list"
    }
  ]
}

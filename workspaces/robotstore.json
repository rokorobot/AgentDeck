{
  "schemaVersion": "agentdeck.workspace.v2",
  "id": "robotstore",
  "name": "RobotStore",
  "rootPath": "E:\\AgentDeck",
  "previewUrl": "http://localhost:5173",
  "health": {
    "type": "http",
    "url": "http://localhost:5173"
  },
  "services": [
    {
      "id": "frontend",
      "label": "Frontend",
      "shell": "powershell.exe",
      "command": "echo 'npm run dev'"
    }
  ],
  "quickActions": [
    {
      "id": "open-folder",
      "label": "Open Folder",
      "type": "openFolder"
    }
  ],
  "terminals": [
    {
      "name": "PowerShell",
      "shell": "powershell.exe",
      "cwd": "E:\\AgentDeck"
    }
  ]
}
